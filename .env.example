# ---- Database (PostgreSQL) ----
# Local Docker default (see docker-compose.yml)
DATABASE_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres"
# In production (Vercel): DATABASE_URL is the Supabase transaction pooler (port 6543, with
# ?pgbouncer=true&connection_limit=1) for the running app's short-lived serverless connections;
# DIRECT_URL is the Supabase session pooler (port 5432), used only for migrations and seeding,
# which need a session-level connection a transaction pooler can't give them.
DIRECT_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres"
# Separate database used by `npm test` integration tests and `npm run test:db` (data is wiped
# between tests). Port 5434, not 5432 — see docker-compose.yml; the default 5432 can collide
# with a native PostgreSQL install on the same machine.
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5434/full_stack_academy_test?schema=public"

# ---- Auth.js ----
# Generate with: npx auth secret   (or any 32+ random characters)
AUTH_SECRET="replace-with-a-long-random-string"
# Set to true behind Vercel / a trusted proxy
AUTH_TRUST_HOST=true

# ---- Seed ----
# The seed creates this admin account if it does not exist. Change the password immediately.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please-123"

# ---- Rate limits ----
# Registrations per IP per hour. Keep this low (5 or less) in production — it is anti-abuse,
# not a usage cap. Playwright's e2e suite registers a fresh user per test from one IP, so its
# own webServer env raises this; never raise it anywhere else. Defaults to 5 if unset.
REGISTER_RATE_LIMIT_PER_HOUR=5

# ---- Optional AI (OpenAI-compatible Chat Completions API) ----
# Leave AI_API_KEY empty to run without AI. All core studying works without it.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
# When true, AI-generated questions that pass automated validation are published immediately
# (still labelled AI-generated). When false (default) an admin must approve them.
AI_AUTO_PUBLISH=false
# Max AI generation requests per user per hour
AI_GENERATION_HOURLY_LIMIT=20
